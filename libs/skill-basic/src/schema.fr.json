            "required": true,
            "description": "Nom de la variable",
            "schema": {
              "type": "object"
            }
          },
          {
            "name": "value",
            "summary": "Valeur",
            "required": false,
            "description": "Valeur à enregistrer",
            "schema": {
              "type": "object"
            }
          },
          {
            "name": "execute",
            "summary": "Exécute",
            "required": false,
            "description": "Actions à appliquer sur la donnée enregistrée",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "https://schemas.digipair.ai/pinsSettings"
              }
            }
          }
