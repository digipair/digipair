    "/trycatch": {
      "post": {
        "tags": [
          "web",
          "service",
          "spatial"
        ],
        "summary": "Attraper les erreurs",
        "description": "Essaye une action et attrape les erreurs",
        "parameters": [
          {
            "name": "executeTry",
