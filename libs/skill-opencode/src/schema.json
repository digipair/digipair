{
  "openapi": "3.0.0",
  "info": {
    "title": "@digipair/skill-opencode",
    "summary": "opencode CLI integration",
    "description": "This skill allows executing prompts using the opencode CLI",
    "version": "0.1.0",
    "x-icon": "🤖"
  },
  "paths": {
    "/runPrompt": {
      "post": {
        "tags": [
          "service"
        ],
        "summary": "Execute opencode prompt",
        "description": "Executes a prompt using the local opencode CLI and returns the result",
        "parameters": [
          {
            "name": "prompt",
            "summary": "Prompt",
            "required": true,
            "description": "The prompt to send to opencode",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "model",
            "summary": "Model",
            "required": false,
            "description": "The opencode model to use",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agent",
            "summary": "Agent",
            "required": false,
            "description": "The opencode agent to use",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "summary": "Output format",
            "required": false,
            "description": "Output format for opencode execution (defaults to 'json'). With 'json' the assistant text is extracted from the JSONL events; with 'default' the raw stdout is returned.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "default"
              ]
            }
          },
          {
            "name": "cwd",
            "summary": "Working directory",
            "required": false,
            "description": "Working directory for opencode execution (defaults to process.cwd() + '/factory/digipairs')",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "timeoutMs",
            "summary": "Timeout",
            "required": false,
            "description": "Timeout in milliseconds",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "debug",
            "summary": "Debug mode",
            "required": false,
            "description": "Enables debug mode",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "onStdout",
            "summary": "On stdout",
            "required": false,
            "description": "Actions to execute when receiving stdout data",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "https://schemas.digipair.ai/pinsSettings"
              }
            }
          },
          {
            "name": "onAction",
            "summary": "On action",
            "required": false,
            "description": "Actions to execute for each parsed JSON event (available as 'action') when format is 'json'",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "https://schemas.digipair.ai/pinsSettings"
              }
            }
          }
        ],
        "x-events": [],
        "responses": {
          "200": {
            "description": "opencode execution result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "description": "The output from the opencode CLI execution"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  },
  "x-scene-blocks": {}
}
