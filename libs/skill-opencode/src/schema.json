{
  "openapi": "3.0.0",
  "info": {
    "title": "@digipair/skill-opencode",
    "summary": "OpenCode SDK integration",
    "description": "This skill allows executing prompts using the OpenCode npm SDK (@opencode-ai/sdk)",
    "version": "0.1.0",
    "x-icon": "🤖"
  },
  "paths": {
    "/runPrompt": {
      "post": {
        "tags": [
          "service"
        ],
        "summary": "Execute OpenCode prompt",
        "description": "Executes a prompt using the local OpenCode SDK and returns the result",
        "parameters": [
          {
            "name": "prompt",
            "summary": "Prompt",
            "required": true,
            "description": "The prompt to send to OpenCode",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agent",
            "summary": "Agent",
            "required": false,
            "description": "OpenCode agent to use for the session (e.g. 'build', 'plan')",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cwd",
            "summary": "Working directory",
            "required": false,
            "description": "Working directory for OpenCode execution (defaults to process.cwd() + '/factory/digipairs')",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "timeoutMs",
            "summary": "Timeout",
            "required": false,
            "description": "Timeout in milliseconds",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "debug",
            "summary": "Debug mode",
            "required": false,
            "description": "Enables debug mode",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "onStdout",
            "summary": "On stdout",
            "required": false,
            "description": "Actions to execute when receiving a server event",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "https://schemas.digipair.ai/pinsSettings"
              }
            }
          },
          {
            "name": "onAction",
            "summary": "On action",
            "required": false,
            "description": "Actions to execute when receiving action data",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "https://schemas.digipair.ai/pinsSettings"
              }
            }
          }
        ],
        "x-events": [],
        "responses": {
          "200": {
            "description": "OpenCode execution result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "description": "The output from the OpenCode SDK execution"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  },
  "x-scene-blocks": {}
}
