{
  "openapi": "3.0.0",
  "info": {
    "title": "@digipair/skill-opencode",
    "summary": "Intégration du SDK OpenCode",
    "description": "Cette skill permet d'exécuter des prompts en utilisant le SDK npm OpenCode (@opencode-ai/sdk)",
    "version": "0.1.0",
    "x-icon": "🤖"
  },
  "paths": {
    "/runPrompt": {
      "post": {
        "tags": [
          "service"
        ],
        "summary": "Exécuter un prompt OpenCode",
        "description": "Exécute un prompt en utilisant le SDK OpenCode local et retourne le résultat",
        "parameters": [
          {
            "name": "prompt",
            "summary": "Prompt",
            "required": true,
            "description": "Le prompt à envoyer à OpenCode",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agent",
            "summary": "Agent",
            "required": false,
            "description": "Agent OpenCode à utiliser pour la session (ex : 'build', 'plan')",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cwd",
            "summary": "Répertoire de travail",
            "required": false,
            "description": "Répertoire de travail pour l'exécution de OpenCode (par défaut process.cwd() + '/factory/digipairs')",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "timeoutMs",
            "summary": "Timeout",
            "required": false,
            "description": "Timeout en millisecondes",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "debug",
            "summary": "Mode débogage",
            "required": false,
            "description": "Active le mode débogage",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "onStdout",
            "summary": "Callback stdout",
            "required": false,
            "description": "Actions à exécuter lors de la réception d'un événement du serveur",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "https://schemas.digipair.ai/pinsSettings"
              }
            }
          },
          {
            "name": "onAction",
            "summary": "Callback action",
            "required": false,
            "description": "Actions à exécuter lors de la réception de données d'action",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "https://schemas.digipair.ai/pinsSettings"
              }
            }
          }
        ],
        "x-events": [],
        "responses": {
          "200": {
            "description": "Résultat de l'exécution OpenCode",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "description": "La sortie de l'exécution du SDK OpenCode"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  },
  "x-scene-blocks": {}
}
