{
  "name": "digipair",
  "version": "0.0.1",
  "type": "commonjs",
  "bin": {
    "digipair": "./bin/digipair.js"
  },
  "dependencies": {
    "@digipair/engine": "0.132.2",
    "@digipair/skill-chatbot": "0.132.2",
    "@digipair/skill-common": "0.132.2",
    "@digipair/skill-cron": "0.132.2",
    "@digipair/skill-basic": "0.132.2",
    "@digipair/skill-canvas": "0.132.2",
    "@digipair/skill-client-mcp": "0.132.2",
    "@digipair/skill-codex": "0.132.2",
    "@digipair/skill-debug": "0.132.2",
    "@digipair/skill-dsp": "0.132.2",
    "@digipair/skill-editor": "0.132.2",
    "@digipair/skill-factory": "0.132.2",
    "@digipair/skill-http": "0.132.2",
    "@digipair/skill-llm": "0.132.2",
    "@digipair/skill-mcp": "0.132.2",
    "@digipair/skill-openai": "0.132.2",
    "@digipair/skill-service": "0.132.2",
    "@digipair/skill-sse": "0.132.2",
    "@digipair/skill-temporal": "0.132.2",
    "@digipair/skill-tool": "0.132.2",
    "@digipair/skill-web": "0.132.2",
    "@digipair/skill-worker": "0.132.2",
    "@digipair/skill-logger": "0.132.2",
    "@digipair/skill-process": "0.132.2",
    "@digipair/skill-oauth2": "0.132.2",
    "@digipair/skill-imap": "0.132.2",
    "@digipair/skill-sendmail": "0.132.2",
    "@digipair/skill-web-debug": "0.132.2",
    "@digipair/skill-web-jsoneditor": "0.132.2",
    "@digipair/skill-web-notification": "0.132.2",
    "@digipair/skill-web-chatbot": "0.132.2",
    "@digipair/skill-web-editor": "0.132.2",
    "@digipair/skill-web-inputs": "0.132.2",
    "@digipair/skill-web-spectrum": "0.132.2",
    "@digipair/skill-web-interact": "0.132.2",
    "@digipair/skill-web-font-awesome": "0.132.2",
    "@digipair/skill-yaml": "0.132.2",
    "tslib": "^2.6.3",
    "@nestjs/common": "^10.3.9",
    "@nestjs/core": "^10.3.9",
    "@nestjs/platform-express": "^10.3.9",
    "@nestjs/serve-static": "^4.0.2",
    "reflect-metadata": "^0.2.2",
    "blockly": "10.4.3",
    "toastify-js": "1.12.0"
  },
  "nx": {
    "name": "factory",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/factory"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/factory/dist/package.json",
          "{workspaceRoot}/apps/factory/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/factory/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "factory:build",
          "runBuildTargetDependencies": false,
          "watch": true
        },
        "configurations": {
          "development": {
            "buildTarget": "factory:build:development"
          },
          "production": {
            "buildTarget": "factory:build:production"
          }
        }
      },
      "test": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{workspaceRoot}/coverage/apps/factory"
        ],
        "options": {
          "jestConfig": "apps/factory/jest.config.ts",
          "passWithNoTests": true
        }
      }
    }
  }
}
